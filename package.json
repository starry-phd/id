{
  "name": "starry-id-foundation",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/sdk"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps packages/sdk/src --max-warnings 0 modules/starry-id-v1/src/w3-local-vnext-typed-self-profile.ts packages/rebuild-billing/src/trusted-store-namespace.ts packages/rebuild-ai3/src",
    "test": "node --experimental-strip-types --test apps/api/test/*.test.mjs apps/mobile/test/*.test.mjs packages/sdk/test/*.test.mjs scripts/promotion/*.test.mjs modules/starry-id-v1/test/*.test.mjs packages/rebuild-billing/test/*.test.mjs packages/rebuild-ai3/test/*.test.mjs",
    "api:dev": "wrangler dev --config apps/api/wrangler.toml --env staging",
    "api:check": "wrangler deploy --dry-run --config apps/api/wrangler.toml --env staging",
    "mobile:config": "npm exec --workspace @starry/id-app -- expo config --type public",
    "web:dev": "npm run web --workspace @starry/id-app",
    "release:blocked": "node docs/release-readiness/check-release-readiness.mjs --assert-blocked",
    "promotion:verify": "node scripts/promotion/verify-curated-release.mjs",
    "auth:typecheck": "tsc --noEmit -p modules/starry-id-v1/tsconfig.json",
    "auth:test": "node --experimental-strip-types --test modules/starry-id-v1/test/*.test.mjs",
    "w3:typecheck": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --allowImportingTsExtensions packages/rebuild-billing/src/trusted-store-namespace.ts packages/rebuild-ai3/src/w3-offline-only-factory.ts",
    "api:runtime": "node --experimental-strip-types --test apps/api/test/*workerd*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.0",
    "@typescript-eslint/parser": "^8.46.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0",
    "yaml": "2.9.1"
  }
}
