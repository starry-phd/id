{
  "name": "starry-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Starry platform API (Starry ID, App Registry, billing projection, battery) on Cloudflare Workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "wrangler deploy --dry-run --outdir dist --env staging",
    "test": "npm run build && node --test --test-force-exit --test-timeout=60000 \"test/*.test.mjs\" && npm run test:unit",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "wrangler dev --env staging",
    "test:unit": "tsx --test --test-force-exit --test-timeout=60000 \"test/unit/*.test.ts\"",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.1",
    "miniflare": "^4.20250101.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "wrangler": "^4.155.0"
  }
}
