{
  // Starry platform Worker. Top level = production, env.staging = staging.
  // Account ID and API token come from CI secrets, never from this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starry-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // Production is served at https://id.starry.phd (account center, Admin Lite and /v1 API).
  "routes": [{ "pattern": "id.starry.phd", "custom_domain": true }],
  "observability": { "enabled": true },
  // Daily maintenance at 03:17 Taiwan time (19:17 UTC): deletion purge, Apple revocations, retention.
  "triggers": { "crons": ["17 19 * * *"] },
  "vars": { "STARRY_ENV": "production", "TERMS_VERSION": "draft-2026-11-03", "PRIVACY_VERSION": "draft-2026-11-03" },
  "d1_databases": [
    {
      "binding": "DB_IDENTITY",
      "database_name": "starry-identity",
      "database_id": "2b523a86-7116-4afc-a02a-f67c20304774",
      "migrations_dir": "migrations/identity"
    }
  ],
  "env": {
    "staging": {
      "name": "starry-id-staging",
      "routes": [],
      "vars": { "STARRY_ENV": "staging", "TERMS_VERSION": "draft-2026-11-03", "PRIVACY_VERSION": "draft-2026-11-03" },
      "d1_databases": [
        {
          "binding": "DB_IDENTITY",
          "database_name": "starry-identity-staging",
          "database_id": "e3fc4307-fb2e-4859-a2eb-4638626dffe8",
          "migrations_dir": "migrations/identity"
        }
      ]
    }
  }
}
