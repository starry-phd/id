{
  // Starry platform Worker. Top level = production, env.staging = staging.
  // Account ID and API token come from CI secrets, never from this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starry-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // Production is served at https://id.starry.phd (account center, Admin Lite and /v1 API).
  "routes": [{ "pattern": "id.starry.phd", "custom_domain": true }],
  "observability": { "enabled": true },
  // Daily maintenance at 03:17 Taiwan time (19:17 UTC): deletion purge, Apple revocations, retention,
  // RevenueCat reconciliation. Every minute: release timed-out Battery reservations (S-BAT-03).
  "triggers": { "crons": ["17 19 * * *", "* * * * *"] },
  "vars": { "STARRY_ENV": "production", "TERMS_VERSION": "2026-11-07", "PRIVACY_VERSION": "2026-11-07.2", "EMAIL_FROM": "support@starry.phd", "SUPPORT_EMAIL": "support@starry.phd", "TURNSTILE_SITE_KEY": "0x4AAAAAAFxiIerv7obs9diV" },
  // Rate limits per Cloudflare location (S-PLT-05). namespace_id is unique per account.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_WEB", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_APP", "namespace_id": "1004", "simple": { "limit": 3000, "period": 60 } }
  ],
  // Cloudflare Email Service sending (S-NTF-02). Sender domain starry.phd is onboarded and verified.
  "send_email": [{ "name": "EMAIL" }],
  // Deletion clean-up retries (ADR 0009). The minute schedule keeps retrying the same D1 jobs, so the queue only makes retries faster.
  "queues": {
    "producers": [{ "binding": "CLEANUP_QUEUE", "queue": "starry-cleanup" }],
    "consumers": [{ "queue": "starry-cleanup", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "starry-cleanup-dlq" }]
  },
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "starry-avatars" },
    { "binding": "SUPPORT_FILES", "bucket_name": "starry-support-files" }
  ],
  "d1_databases": [
    {
      "binding": "DB_IDENTITY",
      "database_name": "starry-identity",
      "database_id": "2b523a86-7116-4afc-a02a-f67c20304774",
      "migrations_dir": "migrations/identity"
    },
    {
      "binding": "DB_BILLING",
      "database_name": "starry-billing",
      "database_id": "5e241e4d-5962-4c1c-90b1-f718e2124f1f",
      "migrations_dir": "migrations/billing"
    },
    {
      "binding": "DB_BATTERY",
      "database_name": "starry-battery",
      "database_id": "94b7ab31-4c86-4038-a1b5-e0d3203eb1b9",
      "migrations_dir": "migrations/battery"
    }
  ],
  "env": {
    "staging": {
      "name": "starry-id-staging",
      "routes": [],
      "vars": { "STARRY_ENV": "staging", "TERMS_VERSION": "2026-11-07", "PRIVACY_VERSION": "2026-11-07.2", "EMAIL_FROM": "support@starry.phd", "SUPPORT_EMAIL": "support@starry.phd", "TURNSTILE_SITE_KEY": "0x4AAAAAAFxiIerv7obs9diV" },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_API", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_WEB", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_APP", "namespace_id": "2004", "simple": { "limit": 3000, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "queues": {
        "producers": [{ "binding": "CLEANUP_QUEUE", "queue": "starry-cleanup-staging" }],
        "consumers": [{ "queue": "starry-cleanup-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "starry-cleanup-dlq-staging" }]
      },
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "starry-avatars-staging" },
        { "binding": "SUPPORT_FILES", "bucket_name": "starry-support-files-staging" }
      ],
      "d1_databases": [
        {
          "binding": "DB_IDENTITY",
          "database_name": "starry-identity-staging",
          "database_id": "e3fc4307-fb2e-4859-a2eb-4638626dffe8",
          "migrations_dir": "migrations/identity"
        },
        {
          "binding": "DB_BILLING",
          "database_name": "starry-billing-staging",
          "database_id": "7d5a045d-5abd-40ab-858f-9af44522f40a",
          "migrations_dir": "migrations/billing"
        },
        {
          "binding": "DB_BATTERY",
          "database_name": "starry-battery-staging",
          "database_id": "c38da8e0-7e55-4517-b22d-f108a3444852",
          "migrations_dir": "migrations/battery"
        }
      ]
    }
  }
}
